<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Location is requested at runtime when route navigation needs it. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>

    <application
        android:name=".JourneyLogApp"


        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyCurrentTour"
        tools:ignore="NotificationPermission">

        <activity android:name=".HomeActivity"/>
        <activity android:name=".TourDetailActivity"/>
        <activity android:name=".OngoingMapActivity"/>
        <activity android:name=".ChatbotActivity" android:exported="false"/>

        <activity android:name=".LoginActivity" />

        <activity
            android:name=".VideoPlayerActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.NoActionBar" />

        <activity
            android:name=".CreateVideoActivity"
            android:exported="false" />

        <activity
            android:name=".CreateTourActivity"
            android:exported="false" />
        <activity
            android:name=".AddWaypointActivity"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>


        <activity android:name=".ViewVideoActivity"
            android:exported="false" />
        <!-- ProfileActivity/EditProfileActivity removed: referenced .java files never existed
             (dead manifest entries). Profile is now ProfileFragment, one of HomeActivity's tabs. -->

    </application>

</manifest>
