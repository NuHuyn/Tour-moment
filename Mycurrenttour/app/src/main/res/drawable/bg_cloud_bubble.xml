<?xml version="1.0" encoding="utf-8"?>
<!-- Main body of the cloud-shaped chatbot hint bubble: very large corner radius so it reads as
     a soft cloud blob rather than a standard rounded rectangle. Paired with bg_cloud_bump.xml
     (small ovals) for the lobes/tail that complete the cloud silhouette. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#FFFDF7" />
    <corners android:radius="20dp" />
    <stroke android:width="1.5dp" android:color="#A5D6A7" />
</shape>
