<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen "Trip Assistant" chat - pushed from the floating chatbot icon on the Discovery tab
     only (see DiscoveryFragment). Own Activity (no bottom nav), back returns to Discovery. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Header: back arrow + chatbot avatar + title, app's light/cream tone (no dark background). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:paddingVertical="12dp"
        android:paddingHorizontal="8dp"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnChatBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back to Discovery"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:scaleType="centerCrop"
            android:src="@drawable/chatbot_avatar_face"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:strokeColor="#2E7D32"
            app:strokeWidth="1.5dp"
            android:contentDescription="Trip Assistant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Trip Assistant"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1B5E20" />
    </LinearLayout>

    <!-- Message canvas: raster illustration sits behind the (transparent) ScrollView so it stays
         fixed while messages scroll over it, with a translucent white wash on top of it to keep
         bubble text readable against the darker/busier parts of the artwork (palm shadow, tree
         cluster at the bottom). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/chat_bg_illustration"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#73FFFFFF"
            android:importantForAccessibility="no" />

        <ScrollView
            android:id="@+id/scrollChatMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutChatMessages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="12dp" />
        </ScrollView>
    </FrameLayout>

    <!-- Quick-reply suggestion chips - only shown for the empty state, before the user sends their
         first message (see ChatbotActivity#hideQuickReplies). -->
    <HorizontalScrollView
        android:id="@+id/scrollQuickReplies"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:scrollbars="none"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/layoutQuickReplies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Input row, fixed at the bottom of the chat screen. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="8dp">

        <EditText
            android:id="@+id/edtChatInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_light_green_round"
            android:hint="Ask about a trip..."
            android:paddingHorizontal="14dp"
            android:textSize="14sp"
            android:inputType="text"
            android:imeOptions="actionSend"
            android:maxLines="1" />

        <ImageView
            android:id="@+id/btnSendChat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:padding="10dp"
            android:background="@drawable/bg_circle_green"
            android:src="@android:drawable/ic_menu_send"
            android:tint="#FFFFFF"
            android:contentDescription="Send message"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
