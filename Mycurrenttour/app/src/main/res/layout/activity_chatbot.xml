<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen "Trip Assistant" chat - pushed from the floating chatbot icon on the Discovery tab
     only (see DiscoveryFragment). Own Activity (no bottom nav), back returns to Discovery.
     bg_chatbot sits full-screen behind the whole chat frame (header, messages, input), z-order
     bottom of the root FrameLayout; everything else is transparent/translucent over it. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_chatbot"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: back arrow, centered bold title + small subtitle, 3-dot menu. No avatar - see
             item_chat_bot_message.xml for why avatars were dropped screen-wide. Transparent, no
             elevation - sits directly on bg_chatbot with no shadow/divider line separating it
             from the chat canvas below. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@android:color/transparent"
            android:paddingVertical="10dp"
            android:paddingHorizontal="4dp">

            <ImageView
                android:id="@+id/btnChatBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/cd_back_to_discovery"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <!-- Single localized title (was a hardcoded English title + Vietnamese subtitle
                     shown together, i.e. two languages at once - see task requirement to remove
                     that). The subtitle line stays in the tree (no XML structure change) but is
                     collapsed via visibility="gone" instead of being deleted. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trip_assistant_title"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:textSize="11sp"
                    android:textColor="@color/text_gray" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnChatMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_more_vert"
                android:tint="#1B5E20"
                android:contentDescription="@string/cd_more_options"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Message canvas: transparent, so bg_chatbot behind the root FrameLayout shows through
             as messages scroll over it. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/scrollChatMessages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutChatMessages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingVertical="12dp" />
            </ScrollView>
        </FrameLayout>

        <!-- Input row, fixed at the bottom of the chat screen. Quick-reply chips used to be a
             standalone bar here; they're now added inline into layoutChatMessages right under the
             greeting bubble (see ChatbotActivity#setupQuickReplies), so this row is input-only. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F2FFFFFF"
            android:padding="10dp"
            android:elevation="8dp">

            <EditText
                android:id="@+id/edtChatInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_light_green_round"
                android:hint="@string/chat_input_hint"
                android:paddingHorizontal="14dp"
                android:textSize="14sp"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/btnSendChat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:padding="12dp"
                android:background="@drawable/bg_circle_green"
                android:src="@drawable/ic_send"
                android:contentDescription="@string/cd_send_message"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
