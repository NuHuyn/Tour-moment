<?xml version="1.0" encoding="utf-8"?>
<!-- "My Tour" tab card (TourAdapter, isHomePage=false) - full-bleed hero-photo card: the trip
     photo fills the entire rounded card, a bottom gradient scrim keeps the overlaid white text
     legible, and the CTA is a filled pill sitting on the photo instead of a separate info panel.
     Same view IDs as item_tour_discovery.xml (title, meta, price, date, the author badge, all 4
     status-only buttons) so TourAdapter's ViewHolder/onBindViewHolder work completely unchanged -
     only this card's own layout/styling differs.

     Sizing: imgTourLogItem is a 0dp/0dp match-constraint pinned to all 4 card edges with a
     240dp layout_constraintHeight_min - that both makes it the height driver for the
     wrap_content CardView (a match-constraint child with a min still contributes to wrap_content
     parent sizing) AND keeps it genuinely full-bleed if the card ever grows taller than 240dp
     (e.g. Completed's two stacked share/video buttons need more room) - the image simply
     stretches to cover whatever the final card height ends up being, instead of leaving
     uncovered space below a fixed-height photo.
     The gradient scrim (viewGradientOverlay) is anchored the same way but from
     guidelineGradientStart (40% down) to the bottom, so it also scales with the card instead of
     being a fixed height that could stop short of the text on a tall Completed card. -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="6dp"
    app:cardPreventCornerOverlap="false"
    app:cardUseCompatPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Full-bleed trip photo - IS the card background, not a thumbnail beside text. -->
        <ImageView
            android:id="@+id/imgTourLogItem"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_min="240dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:scaleType="centerCrop"
            android:src="@drawable/centralvietnam"
            android:contentDescription="@null" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineGradientStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.4" />

        <!-- Bottom scrim so white text reads over any photo brightness. -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_card_gradient_overlay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/guidelineGradientStart"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Discovery-card-only (item_tour_discovery.xml) - kept here just so TourAdapter's
             shared ViewHolder findViewById doesn't NPE; both children are always GONE for My
             Tour cards (reset in TourAdapter#onBindViewHolder). -->
        <LinearLayout
            android:id="@+id/layoutAuthorInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgAuthorItem"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/CircleImage"
                android:src="@drawable/ic_person" />

            <TextView
                android:id="@+id/txtAuthorNameItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="User Name"
                android:textColor="@color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Text overlay: title / meta / date, bottom-left of the card. -->
        <LinearLayout
            android:id="@+id/textBlockItem"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/txtLogTourNameItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Trip name"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.0"
                android:maxLines="2"
                android:ellipsize="end"
                android:shadowColor="#40000000"
                android:shadowRadius="6"
                android:shadowDy="1" />

            <!-- "3N2Đ - Quy Nhơn" - see TourAdapter#buildDurationDestination(). -->
            <TextView
                android:id="@+id/txtTourMetaItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/subtext_light_gray"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLogDateItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Start date"
                android:textColor="@color/subtext_light_gray"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Upcoming-only: filled pill, right-aligned, overlapping the photo at the card's
                 bottom-right. Was sharing a row with a price TextView on the left (pricing was
                 removed, out of scope for the project) - the wrapping RelativeLayout that row
                 needed is gone too, so on Completed/Ongoing (where this stays GONE) it takes zero
                 space instead of leaving a bare margin behind. -->
            <TextView
                android:id="@+id/btnStartJourneyItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill_green"
                android:gravity="center"
                android:paddingHorizontal="22dp"
                android:paddingVertical="12dp"
                android:text="Start the journey"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Completed only - unchanged block style/behavior, just restyled to sit on the
                 photo below the price row instead of on a white card. -->
            <TextView
                android:id="@+id/btnShareToPublicItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_share"
                android:gravity="center"
                android:padding="10dp"
                android:text="Share journey to public"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnMemorableVideoItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_button_share"
                android:gravity="center"
                android:padding="10dp"
                android:text="Memorable video"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Discovery-only ("+ Add this Tour") - never shown here, kept so
             TourAdapter's findViewById doesn't NPE. -->
        <TextView
            android:id="@+id/btnAddTourItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
