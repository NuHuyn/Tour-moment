<?xml version="1.0" encoding="utf-8"?>
<!-- Tour Detail - editorial style (Style B): full-bleed photo carousel, large bold title, and an
     overview-only body (no fixed package price / "Đặt ngay" purchase button - this app monetizes
     per-waypoint, on Route Details/OngoingMapActivity instead). The sticky bottom bar's single
     "Xem lộ trình" button is the only CTA, and just navigates to Route Details. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <ScrollView
        android:id="@+id/scrollTourDetail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="always">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Full-bleed hero photo carousel - genuinely square on all 4 corners now (no
                 rounding at all here), sized by a 16:10 ratio instead of a tall fixed dp height so
                 more of the content below is visible without scrolling. The rounding moved to the
                 content sheet below, which overlaps the photo's bottom edge slightly. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:id="@+id/frameHero"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="#DDDDDD"
                    app:layout_constraintDimensionRatio="H,16:10"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- BlurTarget wraps just the photo (not the floating buttons/counter below
                         in this same FrameLayout) so blurViewHero can sample+blur exactly that,
                         nothing else. -->
                    <eightbitlab.com.blurview.BlurTarget
                        android:id="@+id/blurTargetHero"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <androidx.viewpager2.widget.ViewPager2
                            android:id="@+id/viewPagerHero"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />
                    </eightbitlab.com.blurview.BlurTarget>

                    <!-- Scroll-driven blur overlay (TourDetailActivity#setupHeroScrollBlur) - a
                         live blurred copy of blurTargetHero, radius/dim driven straight off
                         ScrollView's offset each frame (no separate triggered animation). At
                         radius 0 it's visually identical to the sharp photo underneath, so it can
                         just stay in place rather than needing an alpha cross-fade too. Sits above
                         the photo but below the back/heart/share buttons and counter, so those
                         stay crisp and tappable regardless of blur amount. -->
                    <eightbitlab.com.blurview.BlurView
                        android:id="@+id/blurViewHero"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <ImageView
                        android:id="@+id/btnBackDetail"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="16dp"
                        android:background="@drawable/bg_circle_white"
                        android:elevation="4dp"
                        android:padding="10dp"
                        android:src="@drawable/ic_arrow_back"
                        android:contentDescription="@string/back" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="16dp"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/btnFavoriteDetail"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_circle_white"
                            android:elevation="4dp"
                            android:padding="10dp"
                            android:src="@drawable/ic_heart_outline"
                            android:contentDescription="@string/favorite" />

                        <ImageView
                            android:id="@+id/btnShareDetail"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_circle_white"
                            android:elevation="4dp"
                            android:padding="10dp"
                            android:src="@drawable/ic_share"
                            android:contentDescription="@string/share" />
                    </LinearLayout>

                    <!-- "1/2" photo counter -->
                    <TextView
                        android:id="@+id/txtPhotoCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="14dp"
                        android:background="@drawable/bg_pill_dark_translucent"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="1/1"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Content sheet - overlaps the photo's square bottom edge slightly (negative
                 marginTop) with its own rounded top corners (bg_sheet_top_rounded, same 24dp
                 rounded-top drawable used for Route Details' bottom sheet), instead of the photo
                 itself being rounded. paddingTop absorbs the overlap plus normal breathing room
                 above the title. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp"
                android:orientation="vertical"
                android:background="@drawable/bg_sheet_top_rounded"
                android:paddingHorizontal="16dp"
                android:paddingTop="28dp">

                <TextView
                    android:id="@+id/txtTitleDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:text="@string/tour_name_placeholder"
                    android:textColor="#212121"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:lineSpacingMultiplier="1.05" />

                <!-- Provider name + verified badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtProviderDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/provider_placeholder"
                        android:textColor="@color/green_dark_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_check_circle"
                        android:contentDescription="@null" />
                </LinearLayout>

                <!-- Rating row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_star_filled"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/txtRatingDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="4.8"
                        android:textColor="#212121"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtReviewCountDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/review_count_placeholder"
                        android:textColor="#757575"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Info card grid: row 1 - mã tour / thời gian / số chỗ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_light_green_round"
                        android:orientation="vertical"
                        android:padding="10dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_ticket" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/label_tour_code" android:textColor="#757575" android:textSize="11sp" />
                        <TextView android:id="@+id/txtIdDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/not_available" android:textColor="#212121" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="3dp"
                        android:background="@drawable/bg_light_green_round"
                        android:orientation="vertical"
                        android:padding="10dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_time" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/label_duration" android:textColor="#757575" android:textSize="11sp" />
                        <TextView android:id="@+id/txtDurationDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/not_available" android:textColor="#212121" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_light_green_round"
                        android:orientation="vertical"
                        android:padding="10dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_people" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/label_seats_left" android:textColor="#757575" android:textSize="11sp" />
                        <TextView android:id="@+id/txtSeatsDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/not_available" android:textColor="#212121" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Info card grid: row 2 - ngày đi / ngày về -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_light_green_round"
                        android:orientation="vertical"
                        android:padding="10dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_calendar" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/label_start_date" android:textColor="#757575" android:textSize="11sp" />
                        <TextView android:id="@+id/txtStartDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/not_available" android:textColor="#212121" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_light_green_round"
                        android:orientation="vertical"
                        android:padding="10dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_calendar" android:contentDescription="@null" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/label_end_date" android:textColor="#757575" android:textSize="11sp" />
                        <TextView android:id="@+id/txtEndDetail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/not_available" android:textColor="#212121" android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Khám phá điểm đến -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="@string/label_explore_destinations"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/layoutDestinationChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Video preview -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/label_video_preview"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Fixed 16:9 via ConstraintLayout's dimension ratio (not a hardcoded dp height)
                     so the thumbnail keeps a correct, unclipped aspect ratio on any screen width -
                     centerCrop on imgTourDetail still fills that ratio without distortion. -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardPreventCornerOverlap="false"
                        app:cardUseCompatPadding="false"
                        app:strokeWidth="0dp"
                        app:layout_constraintDimensionRatio="H,16:9"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/imgTourDetail"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/centralvietnam" />

                            <androidx.viewpager2.widget.ViewPager2
                                android:id="@+id/viewPagerDetailSlideshow"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone" />

                            <ImageButton
                                android:id="@+id/btnPlaySlideshow"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:layout_gravity="center"
                                android:background="@drawable/bg_circle_play"
                                android:src="@android:drawable/ic_media_play"
                                app:tint="#FFFFFF"
                                android:elevation="5dp"
                                android:contentDescription="@null" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Mô tả chương trình -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/label_description"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/description_placeholder"
                    android:textColor="#555555"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:maxLines="3"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/txtToggleDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="?attr/selectableItemBackground"
                    android:text="@string/show_more_toggle"
                    android:textColor="@color/green_dark_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Sticky bottom bar - single CTA, no price. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewRoute"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/green_dark_primary"
            android:text="@string/btn_view_route"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd"
            app:iconTint="@color/white" />
    </LinearLayout>
</LinearLayout>
