<?xml version="1.0" encoding="utf-8"?>
<!-- Route Details: full-bleed map with a floating header/zoom controls and a draggable bottom
     sheet of stop cards, replacing the old 50/50 map-card + accordion waypoint list. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Edge-to-edge map - no card wrapper, no side margins. -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapOngoing"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating header: back (start) / title (centered on the full width) / recenter (end). -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        android:layout_gravity="top">

        <ImageView
            android:id="@+id/btnBackFromMap"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_white"
            android:elevation="4dp"
            android:padding="11dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Route Details"
            android:textColor="#212121"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnBackFromMap"
            app:layout_constraintBottom_toBottomOf="@id/btnBackFromMap" />

        <ImageView
            android:id="@+id/btnRecenter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_white"
            android:elevation="4dp"
            android:padding="11dp"
            android:src="@drawable/ic_recenter"
            android:contentDescription="@string/recenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- On-demand route info (Feature 1) - hidden until the user taps an unlocked stop; shows
         distance/ETA for the route just drawn to that one waypoint, plus a way to clear it. -->
    <LinearLayout
        android:id="@+id/cardRouteInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="76dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:background="@drawable/bg_pill_white_zoom"
        android:elevation="4dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_pin"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/txtRouteDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="0 km"
            android:textColor="@color/green_dark_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="•"
            android:textColor="#BDBDBD" />

        <TextView
            android:id="@+id/txtRouteDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="0 phút"
            android:textColor="#212121"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btnClearRoute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="✕"
            android:textColor="#757575"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Floating zoom +/- group, right side of the map. -->
    <LinearLayout
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="120dp"
        android:orientation="vertical"
        android:background="@drawable/bg_pill_white_zoom"
        android:elevation="4dp">

        <TextView
            android:id="@+id/btnZoomIn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#212121"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE" />

        <TextView
            android:id="@+id/btnZoomOut"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="−"
            android:textColor="#212121"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Draggable bottom sheet: drag handle, stop card row, page dots, progress banner, actions. -->
    <LinearLayout
        android:id="@+id/sheetRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_sheet_top_rounded"
        android:elevation="12dp"
        android:paddingBottom="20dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_drag_handle" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerRouteStops"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <!-- Page dots - populated in code, one per stop. -->
        <LinearLayout
            android:id="@+id/layoutStopDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <!-- "Bạn đang ở điểm X/Y" progress banner. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:scaleType="fitXY"
                android:src="@drawable/bg_round_detail"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_pin"
                    android:contentDescription="@null" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtRouteProgressLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bạn đang ở điểm 1/1"
                        android:textColor="@color/green_dark_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Hoàn thành để mở toàn bộ hành trình"
                        android:textColor="#757575"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Navigation buttons - "Back" removed (the floating back arrow over the map already
             covers navigation back), so this row is Unlock Now alone, full width. -->
        <FrameLayout
            android:id="@+id/frameUnlockFull"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:layout_marginHorizontal="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnlockFull"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Unlock Now"
                android:backgroundTint="@color/green_dark_primary"
                android:textColor="@color/white"
                app:cornerRadius="28dp" />

            <!-- Kept fully inside frameUnlockFull's own bounds (small positive margins, not a
                 negative offset poking past the edge) so it can never get clipped by an ancestor
                 that doesn't happen to have clipChildren/clipToPadding disabled on every device -
                 that "overflow past the corner" look depended on clipping being turned off all
                 the way up the view tree, which is fragile across screen widths/densities. -->
            <TextView
                android:id="@+id/badgeUnlockDiscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="6dp"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="-25%"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:elevation="6dp" />
        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
