<?xml version="1.0" encoding="utf-8"?>
<!-- Discovery tab (was activity_home.xml's content). Hosted inside HomeActivity's
     fragmentContainer so the bottom nav bar stays fixed across all tabs.

     The chatbot FAB + chat panel below are part of THIS fragment's own view tree only
     (not activity_home.xml, which is shared by every tab) - so switching tabs destroys this
     view and the chatbot disappears with it, exactly as intended. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F8E9"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/txtWelcome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome back"
                android:textSize="14sp"
                android:textColor="#666666" />
            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_person"
                android:scaleType="centerCrop" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discover the Best Place"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1B5E20"
            android:layout_marginTop="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/searchLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:hintEnabled="false"
            app:startIconDrawable="@android:drawable/ic_menu_search"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Search tour, destination..."
                android:inputType="text"
                android:padding="10dp"
                android:background="@null"
                android:imeOptions="actionSearch"/>
        </com.google.android.material.textfield.TextInputLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="12dp">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tất cả"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:checked="true"/>
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quy Nhơn"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tây Ninh"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>
                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cần Thơ"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Popular"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPopular"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Tours"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerTours"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp" />
    </LinearLayout>

    <!-- Floating chatbot launcher - bottom-right corner of the Discovery content area only.
         Pushes ChatbotActivity (full-screen chat) instead of an in-place overlay.
         Circular avatar, same ShapeableImageView + CircleImage pattern used for every other
         avatar in the app (imgAuthorItem, imgAvatarProfile, ...). -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/btnChatbotFab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:scaleType="centerCrop"
        android:src="@drawable/chatbot_avatar_face"
        app:shapeAppearanceOverlay="@style/CircleImage"
        app:strokeColor="#2E7D32"
        app:strokeWidth="2dp"
        android:contentDescription="Open trip assistant chat"
        android:elevation="6dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- One-time-per-session hint bubble that draws attention to the chatbot FAB (see
         setupChatbotHint() in DiscoveryFragment). Cloud shape = rounded bubble body
         (bg_cloud_bubble) + small round "lobes"/tail dots (bg_cloud_bump) layered on top,
         since a plain shape drawable can't express a wavy cloud outline on its own. -->
    <FrameLayout
        android:id="@+id/cloudBubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="96dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="gone"
        android:alpha="0"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/txtCloudBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:maxWidth="190dp"
            android:background="@drawable/bg_cloud_bubble"
            android:padding="12dp"
            android:textColor="#1B5E20"
            android:textSize="13sp"
            android:elevation="4dp"
            tools:text="Bạn muốn đi đâu hôm nay?" />

        <!-- cloud lobe peeking from the main bubble's bottom-start edge -->
        <View
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="-4dp"
            android:background="@drawable/bg_cloud_bump" />

        <!-- tail: 2 shrinking dots trailing down toward the chatbot FAB -->
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="26dp"
            android:layout_marginBottom="-16dp"
            android:background="@drawable/bg_cloud_bump" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="-26dp"
            android:background="@drawable/bg_cloud_bump" />
    </FrameLayout>
</FrameLayout>
