<?xml version="1.0" encoding="utf-8"?>
<!-- One stop card in Route Details' horizontally-scrolling row (RouteStopAdapter). Full-bleed
     photo + bottom gradient scrim, same pattern as My Travel's item_tour.xml hero card, just
     narrower and with a number/status badge pair instead of price/CTA. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRouteStop"
    android:layout_width="132dp"
    android:layout_height="172dp"
    android:layout_marginEnd="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeWidth="0dp"
    app:strokeColor="@color/green_dark_primary">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imgStopPhoto"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:scaleType="centerCrop"
            android:src="@drawable/centralvietnam"
            android:contentDescription="@null" />

        <!-- Frosted-glass scrim for a still-locked stop (Feature 2) - sits over the blurred
             placeholder photo, under the gradient/text. Gone for free/unlocked stops. -->
        <View
            android:id="@+id/viewStopLockedScrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#552D5A3D"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineStopGradient"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.42" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_card_gradient_overlay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/guidelineStopGradient"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- "01" / "02" / "03" -->
        <TextView
            android:id="@+id/txtStopNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge_number"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="01"
            android:textColor="#212121"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Green check (completed/unlocked) or gray lock (still locked). -->
        <ImageView
            android:id="@+id/imgStopStatus"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            android:padding="4dp"
            android:background="@drawable/bg_circle_green"
            android:src="@drawable/ic_check_plain"
            android:scaleType="centerInside"
            android:contentDescription="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/txtStopName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Stop name"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txtStopDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Description"
                android:textColor="@color/subtext_light_gray"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="0.95" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
