<?xml version="1.0" encoding="utf-8"?>
<!-- One bot message row inside ChatbotActivity's message list: bubble + small timestamp
     underneath, left-aligned (see Gravity.START applied when this is added to
     layoutChatMessages). No avatar - neither side shows one, so the chat reads more like texting
     a real person than talking to a bot. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtBotBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bubble_bot"
        android:elevation="4dp"
        android:textColor="#212121"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        android:padding="10dp" />

    <TextView
        android:id="@+id/txtBotTimestamp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="3dp"
        android:textColor="#9E9E9E"
        android:textSize="10sp" />
</LinearLayout>
