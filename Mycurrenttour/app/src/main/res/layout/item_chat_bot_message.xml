<?xml version="1.0" encoding="utf-8"?>
<!-- One bot message row inside ChatbotActivity's message list: circular avatar + bubble + small
     timestamp underneath, left-aligned (see Gravity.START applied when this is added to
     layoutChatMessages). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="bottom">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgBotAvatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="6dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/CircleImage"
        android:src="@drawable/chatbot_avatar_face" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtBotBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_bot"
            android:elevation="4dp"
            android:textColor="#212121"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/txtBotTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="3dp"
            android:textColor="#9E9E9E"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
