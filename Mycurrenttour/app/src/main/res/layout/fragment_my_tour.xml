<?xml version="1.0" encoding="utf-8"?>
<!-- "My Tour" tab (was activity_my_tour.xml's content).

     Filter row: all 4 chips (Trip/Upcoming/Ongoing/Completed) live in ONE singleSelection
     ChipGroup, reusing the exact same chip_filter_bg/text/stroke selectors + Chip.Choice style as
     Discovery's region chips - the framework then guarantees exactly one is ever checked
     (filled-green) at a time, tapping any one auto-unchecks whichever was checked before.
     (Trip was previously a separate, statically-styled chip OUTSIDE this group, which is why it
     and Upcoming could both render as checked/green at once - a real bug, not just styling.)
     MyTourFragment's existing per-chip OnClickListener -> switchFilter(status) calls are
     untouched (Trip's still opens CreateTourActivity instead of filtering) - only what gets
     inflated, and now the single-selection grouping, changed. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Leafy/mountain illustration behind the whole screen (bg_mytravel.png) - sits under the
         scrollable content below, same idea as the login screen's full-bleed background. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_mytravel"
        android:contentDescription="@null" />

    <ScrollView
        android:id="@+id/scrollMyTour"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="140dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="@string/my_travel_title"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#212121"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupMyTour"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <!-- Opens CreateTourActivity on click (see MyTourFragment) rather than filtering
                     anything - still participates in this group purely so the framework keeps
                     the checked/unchecked visuals mutually exclusive with the other 3. -->
                <com.google.android.material.chip.Chip
                    android:id="@+id/btnTrip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_trip"
                    android:textColor="@color/chip_filter_text"
                    app:chipBackgroundColor="@color/chip_filter_bg"
                    app:chipStrokeColor="@color/chip_filter_stroke"
                    app:chipStrokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/btnUpcoming"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_upcoming"
                    android:checked="true"
                    android:textColor="@color/chip_filter_text"
                    app:chipBackgroundColor="@color/chip_filter_bg"
                    app:chipStrokeColor="@color/chip_filter_stroke"
                    app:chipStrokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/btnOngoing"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_ongoing"
                    android:textColor="@color/chip_filter_text"
                    app:chipBackgroundColor="@color/chip_filter_bg"
                    app:chipStrokeColor="@color/chip_filter_stroke"
                    app:chipStrokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/btnCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/chip_completed"
                    android:textColor="@color/chip_filter_text"
                    app:chipBackgroundColor="@color/chip_filter_bg"
                    app:chipStrokeColor="@color/chip_filter_stroke"
                    app:chipStrokeWidth="1dp"
                    style="@style/Widget.MaterialComponents.Chip.Choice"/>
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMyTours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

    </LinearLayout>
    </ScrollView>

    <!-- Shown while loadMyTours() has a request in flight (see MyTourFragment) - covers both the
         Cloud Run cold-start case (first request after idle can take a couple seconds) and normal
         network latency, so the screen never just sits static/unresponsive-looking during a fetch. -->
    <ProgressBar
        android:id="@+id/progressMyTour"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/brand_green"
        android:visibility="gone" />
</FrameLayout>
