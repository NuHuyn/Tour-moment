<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Splash / Login flow -->
    <color name="brand_green">#4CAF50</color>
    <color name="link_light_green">#9CCC65</color>
    <color name="subtext_light_gray">#E0E0E0</color>
    <color name="overlay_dark">#B3000000</color>

    <!-- Profile screen -->
    <color name="screen_bg_gray">#F5F6F8</color>
    <color name="text_gray">#8A8A8E</color>
    <color name="divider_gray">#EEEEEE</color>
    <color name="error_red">#E53935</color>

    <!-- Reels empty state (matches the app's existing primary green used elsewhere, e.g. TourDetailActivity) -->
    <color name="green_dark_primary">#2E7D32</color>
    <!-- Tour Detail reviews section - divider lines between review cards (a bit more visible than
         bg_light_green_round's #E8F5E9 chip fill, still on the same pale-green family). -->
    <color name="divider_light_green">#C8E6C9</color>

    <!-- Floating bottom nav capsule -->
    <!-- Inactive icon/label tint - shared by bottom_nav_icon_color.xml, bottom_nav_item_color.xml
         and HomeActivity's per-tab switch animation, instead of each hardcoding #9E9E9E. -->
    <color name="bottom_nav_inactive_gray">#9E9E9E</color>
    <!-- Overlay tint drawn on top of the real-time blur (BlurView) inside navBarContainer - lets
         scrolled content read as a faint, frosted shape through the capsule instead of a flat
         opaque bar. -->
    <color name="nav_blur_overlay">#99FFFFFF</color>
</resources>