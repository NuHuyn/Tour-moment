<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyCurrentTour" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- App's real palette is the brand green, not Material3's default purple baseline -
             without this override the status bar and any default-tinted widgets (e.g. the bottom
             nav's active-item indicator) render purple instead of matching the rest of the UI. -->
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.MyCurrentTour" parent="Base.Theme.MyCurrentTour" />

    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedCorner12dp">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="RoundedCorner16dp">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Tour Detail's full-bleed photo carousel (activity_tour_detail.xml) - square top (flush
         with the screen edge), rounded bottom where it meets the white content sheet below. -->
    <style name="RoundedBottomCorner24dp">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">24dp</item>
        <item name="cornerSizeBottomRight">24dp</item>
    </style>

    <!-- Login screen's email/password TextInputLayouts (activity_login.xml) - filled white pill
         box (same rounding as the screen's other pill buttons) so the form reads clearly against
         the dark photo background, dark text/hint on white rather than the app's usual
         green-bordered outline box (that style assumes a white screen background, which this
         screen doesn't have). -->
    <style name="LoginInputBox" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="hintTextColor">@color/green_dark_primary</item>
        <item name="android:textColorHint">#757575</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
    </style>

    <!-- Bottom nav's active-tab indicator, made fully transparent - the redesigned floating
         capsule nav (activity_home.xml) shows active state purely via the icon/label turning
         green (bottom_nav_icon_color.xml / bottom_nav_item_color.xml) plus HomeActivity's
         scale+color-fade animation, not a filled pill behind the icon. The style is kept (rather
         than deleted) so BottomNavigationView still reserves its normal layout space for the
         indicator - only its color changes. -->
    <style name="ActiveIndicator.MyCurrentTour" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>
</resources>